FROM golang:1.23-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/vexstream-relay ./cmd/vexstream-relay
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/vexstream-relay ./cmd/vexstream-relay

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/vexstream-relay /usr/local/bin/vexstream-relay

ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/vexstream-relay"]
